# ESP-NODE-2RDM prototype: ESP32-S3 N16R8 dev board
# (applied on top of the top-level sdkconfig.defaults by tools/build.sh)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOARD_ESP_NODE_2RDM=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# 8 MB octal PSRAM; allocations over 16 KB go there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Received packets and lwIP buffers in PSRAM. The option makes Wi-Fi transmit
# buffers static in internal RAM (16 x 1.6 KB), so less is free when idle
# (~40 KB, ~57 without), but a flood plus one web client left 23.7 KB at
# worst, 5.3 without (several clients: 16.9 with it, see docs/DEVELOPING.md).
# The values below are the ones that was measured with: the option would
# otherwise raise RX buffers and the BA window to 16 (~10 KB more internal RAM)
# and lift the limit on out-of-order TCP packets.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
