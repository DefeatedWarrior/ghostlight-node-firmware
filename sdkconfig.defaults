# Settings shared by every board. Board-specific ones (chip, flash size,
# PSRAM, partition table) are in boards/<name>/sdkconfig.defaults, which
# tools/build.sh applies on top of this file.

# --- Partition table (file chosen by the board) ---
CONFIG_PARTITION_TABLE_CUSTOM=y

# --- OTA: roll back automatically if new firmware fails to start ---
# main.c marks the image valid after 30 s of healthy running.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Core dump to flash (read with: idf.py coredump-info, or download it
# from the web UI: System > Crash report) ---
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# --- Task watchdog: the DMX tasks, the network supervisor and both idle
# tasks are watched. If one stops for 10 s the node writes a crash report
# and restarts instead of hanging with frozen output. ---
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- FreeRTOS & Stack Sizes ---
# 1 kHz tick: DMX frame timing (23 ms) and short waits are exact instead of
# being rounded to 10 ms steps.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# --- LwIP (Networking) ---
# Sockets: Art-Net, sACN rx/tx, HTTP server + up to 10 browser connections
CONFIG_LWIP_MAX_SOCKETS=20
# Room for bursts of Art-Net/sACN packets (several sources x 2 universes)
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_WND_DEFAULT=11520

# --- Ethernet W5500 ---
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# --- HTTP Server (Web UI) ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=y

# --- DMX / RDM (esp_dmx) ---
CONFIG_DMX_ISR_IN_IRAM=y
# 0x7FF0-0x7FFF is ESTA's range for prototypes; replace with your own
# ESTA manufacturer ID for a product. Device ID 0xFFFFFFFF = derive from MAC.
CONFIG_RDM_DEVICE_UID_MAN_ID=0x7ff0
CONFIG_RDM_MANUFACTURER_LABEL="ESP-NODE-2RDM"

# --- Compiler Optimization ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y
